# ----------------------------------------------------------------------------
# Shopping Agent - environment configuration
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored.
# ----------------------------------------------------------------------------

# Supabase Postgres connection string of the ORIGINAL (business) database.
# Used ONLY by `scan` and `clone`, always in READ ONLY transactions.
# Example:
#   postgresql://postgres:PASSWORD@db.abcdefgh.supabase.co:5432/postgres
# Prefer the direct connection or the *session-mode* pooler (port 5432);
# the transaction-mode pooler (port 6543) breaks session settings.
SOURCE_DATABASE_URL=

# Optional: connection string of a SEPARATE database that holds the copy.
# If empty, the copy lives in the same database as the source (separate schema).
COPY_DATABASE_URL=

# Schema (inside the copy database) that receives the cloned catalog and all
# record tables (orders, returns, refunds, chat). Must not be "public" and must
# differ from the source schema.
COPY_SCHEMA=agent_copy

# Optional: schema of the ORIGINAL database that holds the business tables.
SOURCE_SCHEMA=public

# Groq API key (https://console.groq.com). Never logged, never sent anywhere.
GROQ_API_KEY=

# Groq model used by the chat agent. Must support tool calling.
# Default: llama-3.3-70b-versatile (open-source, tool-calling, on Groq's list).
GROQ_MODEL=llama-3.3-70b-versatile

# Store identity shown to customers in chat.
STORE_NAME=Demo Store

# Display currency for prices (no conversion is performed).
CURRENCY=INR

# Customers may request a return for a completed order within this many days.
RETURN_WINDOW_DAYS=7

# A pending order/cancel confirmation expires after this many minutes.
CONFIRMATION_TTL_MINUTES=15

# Optional: override ONLY for the pytest suite (throwaway test database).
TEST_DATABASE_URL=
